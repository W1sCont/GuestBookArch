﻿@using Microsoft.AspNetCore.Http
@{
    var currentUser = Context.Session.GetString("login");
    var currentName = Context.Session.GetString("Name");
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Гостьова книга</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Guestbook.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-chat-left-text-fill me-2"></i>Guestbook
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Ліва частина меню -->
                    <ul class="navbar-nav flex-grow-1">
                        @if (!string.IsNullOrEmpty(currentUser))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light fw-semibold" asp-controller="Home" asp-action="CreateMessage">
                                    <i class="bi bi-plus-square me-1"></i>Написати коментар
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (!string.IsNullOrEmpty(currentUser))
                        {
                            <li class="nav-item me-3">
                                <span class="navbar-text text-white fw-semibold">
                                    <i class="bi bi-person-circle me-1 text-primary"></i>@currentName
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Home" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i>Вийти
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm rounded-pill px-3 fw-semibold"
                                   asp-controller="Home" asp-action="LogIn">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Увійти
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold"
                                   asp-controller="Home" asp-action="CreateUser">
                                    <i class="bi bi-person-plus me-1"></i>Реєстрація
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 bg-white mt-auto">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - Гостьова книга ASP.NET Core MVC
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>