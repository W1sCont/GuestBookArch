@model Guestbook.Models.CreateUser

@{
    ViewData["Title"] = "Реєстрація";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-person-plus me-2"></i>Реєстрація нового користувача
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="CreateUser" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-bold text-dark">Ім'я</label>
                                <input asp-for="Name" class="form-control" placeholder="Введіть ім'я" />
                                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Surname" class="form-label fw-bold text-dark">Прізвище</label>
                                <input asp-for="Surname" class="form-control" placeholder="Введіть прізвище" />
                                <span asp-validation-for="Surname" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Login" class="form-label fw-bold text-dark">Логін</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary"><i class="bi bi-at"></i></span>
                                <input asp-for="Login" class="form-control" placeholder="Вигадайте логін" />
                            </div>
                            <span asp-validation-for="Login" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold text-dark">Пароль</label>
                            <input asp-for="Password" class="form-control" placeholder="Введіть пароль" />
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PasswordConfirm" class="form-label fw-bold text-dark">Підтвердження пароля</label>
                            <input asp-for="PasswordConfirm" class="form-control" placeholder="Повторіть пароль" />
                            <span asp-validation-for="PasswordConfirm" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                Повернутися
                            </a>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold shadow-sm">
                                Зареєструватися
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}