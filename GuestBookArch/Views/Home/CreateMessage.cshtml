@model Guestbook.Models.CreateMessage
@{
    ViewData["Title"] = "Create Message";
}

<h2 class="text-secondary mb-4">Додати новий коментар</h2>
@if (Context.Session.GetInt32("UserId") != null)
{
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
                        <h4 class="mb-0 fw-bold">
                            <i class="bi bi-chat-square-quote me-2"></i>Додати коментар
                        </h4>
                    </div>

                    <div class="card-body p-4">
                        <form asp-action="CreateMessage" method="post">
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <div class="mb-4">
                                <label asp-for="Message" class="form-label fw-bold text-dark">
                                    Ваше повідомлення
                                </label>
                                <textarea asp-for="Message"
                                          class="form-control form-control-lg fs-6"
                                          rows="5"
                                          placeholder="Напишіть свій коментар тут..."></textarea>
                                <span asp-validation-for="Message" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2">
                                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                    Повернутися
                                </a>
                                <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold shadow-sm">
                                    Опублікувати
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p>Щоб залишити коментар, будь ласка, <a asp-action="LogIn">увійдіть</a>.</p>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}